# Optional overrides for geo_build.py. Command-line flags win over these.
# The script reads them from the environment; it does not load this file itself:
#   set -a; . ./.env; set +a; python3 geo_build.py

# Site directory (site.json, layout.html, content/, static/). Default: ./example
GEO_SITE_DIR=example

# Output directory. It is deleted and rebuilt on every run. Default: ./dist
GEO_OUT_DIR=dist

# Replace site.json "base_url", e.g. for a staging build. Default: unset
# GEO_BASE_URL=https://staging.example.com

# 1 = links to pages that do not exist yet become warnings instead of errors.
# GEO_DRAFT=1
